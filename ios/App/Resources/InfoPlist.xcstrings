{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad verwendet dein lokales Netzwerk, um Geräte zu finden und die Kopplung abzuschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad utilise votre réseau local pour détecter les appareils et terminer le jumelage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad usa la rete locale per trovare i dispositivi e completare l'abbinamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad использует локальную сеть, чтобы находить устройства и завершать сопряжение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad 使用本地网络发现设备并完成配对。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad usa tu red local para encontrar dispositivos y completar el emparejamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AltLoad usa sua rede local para encontrar dispositivos e concluir o emparelhamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoadはデバイスを検出してペアリングを完了するためにローカルネットワークを使用します。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad kann den Standort nutzen, um im Hintergrund weiterzulaufen, während du die Kopplung in den Einstellungen abschließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad peut utiliser la position pour continuer en arrière-plan pendant que vous terminez le jumelage dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad può usare la posizione per restare attiva in background mentre completi l'abbinamento in Impostazioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad может использовать геопозицию, чтобы работать в фоне, пока вы завершаете сопряжение в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad 可使用位置在后台持续运行，以便你在“设置”中完成配对。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad puede usar la ubicación para seguir funcionando en segundo plano mientras completas el emparejamiento en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AltLoad pode usar a localização para continuar funcionando em segundo plano enquanto você conclui o emparelhamento em Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoadは、“設定”でペアリングを完了するあいだバックグラウンドで動作し続けるために位置情報を使用することがあります。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
