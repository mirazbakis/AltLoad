    "Apple asked for a two-factor code.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat einen Bestätigungscode verlangt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
