    "Switched on but not in the profile yet: %@. Refresh the app to ask again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschaltet, aber noch nicht im Profil: %@. Aktualisiere die App, um erneut zu fragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado, pero aún no está en el perfil: %@. Actualiza la app para volver a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé, mais pas encore dans le profil : %@. Actualisez l’app pour redemander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato ma non ancora nel profilo: %@. Aggiorna l’app per richiederlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンになっていますが、まだプロファイルにありません: %@。アプリを更新して再度要求してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado, mas ainda não está no perfil: %@. Atualize o app para perguntar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено, но ещё не добавлено в профиль: %@. Обновите приложение, чтобы запросить снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启但尚未加入描述文件：%@。刷新该 App 以重新请求。"
          }
        }
      }
    },
    "Switched-on entitlements are enabled on AltStore's App ID with your Apple ID, then added to its signature the next time you install or refresh it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierte Berechtigungen werden mit deiner Apple-ID für die App-ID von AltStore eingeschaltet und bei der nächsten Installation oder Aktualisierung seiner Signatur hinzugefügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les droits activés sont appliqués à l'identifiant d'app d'AltStore avec votre identifiant Apple, puis ajoutés à sa signature à la prochaine installation ou actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli entitlement attivati vengono abilitati sull'ID app di AltStore con il tuo ID Apple, poi aggiunti alla sua firma alla prossima installazione o aggiornamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включённые разрешения активируются для App ID приложения AltStore с вашим Apple ID и добавляются в его подпись при следующей установке или обновлении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启的权限会用你的 Apple ID 在 AltStore 的 App ID 上启用，并在下次安装或刷新时添加到其签名中。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los derechos activados se habilitan en el App ID de AltStore con tu ID de Apple, y luego se añaden a su firma la próxima vez que lo instales o actualices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしたエンタイトルメントは、あなたの Apple ID で AltStore の App ID に対して有効になり、次回インストールまたは更新時に署名に追加されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os direitos ativados são habilitados no App ID do AltStore com seu ID Apple, e depois adicionados à assinatura dele na próxima vez que você o instalar ou atualizar."
          }
        }
      }
    },
    "Switched-on entitlements are enabled on the app's App ID with your Apple ID, then added to its signature the next time you install or refresh it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschaltete Berechtigungen werden mit deiner Apple-ID für die App-ID der App aktiviert und beim nächsten Installieren oder Aktualisieren zur Signatur hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los derechos activados se habilitan en el App ID de la app con tu ID de Apple, y luego se añaden a su firma la próxima vez que lo instales o actualices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les droits activés sont activés sur l’App ID de l’app avec votre identifiant Apple, puis ajoutés à sa signature lors de la prochaine installation ou actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I diritti attivati vengono abilitati sull’App ID dell’app con il tuo Apple ID, quindi aggiunti alla sua firma alla prossima installazione o aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしたエンタイトルメントは、あなたの Apple ID でアプリの App ID に対して有効になり、次回インストールまたは更新時に署名に追加されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os direitos ativados são habilitados no App ID do app com seu ID Apple, e depois adicionados à assinatura dele na próxima vez que você o instalar ou atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включённые права активируются для App ID приложения с вашим Apple ID, а затем добавляются в его подпись при следующей установке или обновлении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启的权利会通过你的 Apple ID 在该 App 的 App ID 上启用，并在下次安装或刷新时添加到其签名中。"
          }
        }
      }
    },
