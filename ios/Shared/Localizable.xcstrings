            "state": "translated",
            "value": "AltStore hat eine leere App gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore a envoyé une app vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore ha inviato un'app vuota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore отправил пустое приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore 发送了一个空的 App。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore envió una app vacía."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore が空のアプリを送信しました。"
          }
