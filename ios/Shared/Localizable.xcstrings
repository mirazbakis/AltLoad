    "Background time expired before a device connected. Tap Pair to try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hintergrundzeit ist abgelaufen, bevor sich ein Gerät verbunden hat. Tippe auf „Koppeln“, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps en arrière-plan a expiré avant la connexion d'un appareil. Touchez Jumeler pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo in background è scaduto prima che si connettesse un dispositivo. Tocca Abbina per riprovare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время работы в фоне истекло до подключения устройства. Нажмите «Создать пару», чтобы повторить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备连接前后台时间已用完。请轻点“配对”重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo en segundo plano antes de que se conectara un dispositivo. Toca Emparejar para intentarlo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが接続する前にバックグラウンド時間が切れました。「ペアリング」をタップして再試行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo em segundo plano expirou antes de um dispositivo se conectar. Toque em Parear para tentar novamente."
          }
        }
      }
    },
