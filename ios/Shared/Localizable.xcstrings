    "Every app and extension AltLoad signs uses an App ID. A free Apple ID can have 10 at a time, and each one frees up 7 days after it was made.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede von AltLoad signierte App und Erweiterung nutzt eine App-ID. Eine kostenlose Apple-ID kann 10 gleichzeitig haben, und jede wird 7 Tage nach ihrer Erstellung frei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque app et extension signée par AltLoad utilise un identifiant d'app. Un identifiant Apple gratuit peut en avoir 10 à la fois, et chacun se libère 7 jours après sa création."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni app ed estensione firmata da AltLoad usa un ID app. Un ID Apple gratuito può averne 10 alla volta, e ognuno si libera 7 giorni dopo la creazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое приложение и расширение, подписанное AltLoad, использует App ID. У бесплатного Apple ID их может быть 10 одновременно, и каждый освобождается через 7 дней после создания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad 签名的每个 App 和扩展都使用一个 App ID。免费 Apple ID 同时最多 10 个，每个在创建 7 天后释放。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada app y extensión que firma AltLoad usa un App ID. Un ID de Apple gratuito puede tener 10 a la vez, y cada uno se libera 7 días después de crearse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoadが署名するすべてのアプリとエクステンションは App ID を使用します。無料の Apple ID では同時に10個まで持てます。それぞれ作成から7日後に解放されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada app e extensão que o AltLoad assina usa um App ID. Um ID Apple gratuito pode ter 10 por vez, e cada um é liberado 7 dias após a criação."
          }
        }
      }
    },
    "Every app uses this set. Pick an installed app to give it its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Apps verwenden diesen Satz. Wähle eine installierte App, um ihr einen eigenen zu geben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las apps usan este conjunto. Elige una app instalada para darle el suyo propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les apps utilisent ce jeu. Choisissez une app installée pour lui en attribuer un propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le app usano questo set. Scegli un’app installata per assegnarle un set proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリがこの設定を使用します。インストール済みのアプリを選ぶと、そのアプリ専用の設定を作れます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os apps usam este conjunto. Escolha um app instalado para dar a ele um próprio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все приложения используют этот набор. Выберите установленное приложение, чтобы задать ему собственный набор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 App 都使用此集合。选择一个已安装的 App 为其设置单独的集合。"
          }
        }
      }
    },
