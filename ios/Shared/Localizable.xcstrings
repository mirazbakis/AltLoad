    },
    "There's no pairing file for this iPhone yet. Create one in Tools › Pair first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses iPhone gibt es noch keine Kopplungsdatei. Erstelle zuerst eine unter Werkzeuge › Koppeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n'a pas encore de fichier de jumelage. Créez-en d'abord un dans Outils › Jumeler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone non ha ancora un file di abbinamento. Creane prima uno in Strumenti › Abbina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого iPhone пока нет файла сопряжения. Сначала создайте его в «Инструменты › Создать пару»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 还没有配对文件。请先在“工具 › 配对”中创建。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay archivo de emparejamiento para este iPhone. Crea uno en Herramientas › Emparejar primero."
          }
        },
        "ja": {
          "stringUnit": {
