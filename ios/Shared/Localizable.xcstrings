    "Installs go through LocalDevVPN, which loops this address back into the iPhone. Only change it if you changed LocalDevVPN's peer IP.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationen laufen über LocalDevVPN, das diese Adresse zurück ins iPhone leitet. Ändere sie nur, wenn du die Peer-IP von LocalDevVPN geändert hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les installations passent par LocalDevVPN, qui renvoie cette adresse vers l'iPhone. Ne la modifiez que si vous avez changé l'IP du pair de LocalDevVPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le installazioni passano da LocalDevVPN, che rimanda questo indirizzo all'iPhone. Cambialo solo se hai cambiato l'IP peer di LocalDevVPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка идёт через LocalDevVPN, который возвращает этот адрес обратно в iPhone. Меняйте его, только если изменили IP пира в LocalDevVPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装通过 LocalDevVPN 进行，它会把此地址回环到 iPhone。除非更改了 LocalDevVPN 的对端 IP，否则请勿修改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instalaciones pasan por LocalDevVPN, que devuelve esta dirección al propio iPhone. Cámbiala solo si cambiaste la IP del par de LocalDevVPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールはLocalDevVPNを経由し、このアドレスをiPhone自身へループバックさせます。LocalDevVPNのピアIPを変更した場合のみ変更してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As instalações passam pelo LocalDevVPN, que redireciona este endereço de volta para o iPhone. Altere-o apenas se tiver mudado o IP do par do LocalDevVPN."
          }
        }
      }
    },
    "Installs, refreshes and this screen use the team you pick. Automatic uses the first one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationen, Aktualisierungen und dieser Bildschirm verwenden das Team, das du auswählst. Automatisch verwendet das erste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instalaciones, actualizaciones y esta pantalla usan el equipo que elijas. Automático usa el primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les installations, actualisations et cet écran utilisent l’équipe choisie. Automatique utilise la première."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installazioni, aggiornamenti e questa schermata usano il team che scegli. Automatico usa il primo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール、更新、およびこの画面では選択したチームを使用します。「自動」は最初のチームを使用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As instalações, atualizações e esta tela usam a equipe que você escolher. Automático usa a primeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка, обновление и этот экран используют выбранную команду. «Автоматически» использует первую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装、刷新以及此屏幕将使用你选择的团队。“自动”将使用第一个团队。"
          }
        }
      }
    },
