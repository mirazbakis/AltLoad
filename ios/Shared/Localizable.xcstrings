    "Signing in here checks your Apple ID with Apple straight away, including two-factor, without installing anything.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hier prüft deine Apple-ID sofort bei Apple, einschließlich Zwei-Faktor-Code, ohne etwas zu installieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter ici vérifie immédiatement votre identifiant Apple auprès d'Apple, double authentification comprise, sans rien installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedere qui verifica subito il tuo ID Apple con Apple, autenticazione a due fattori inclusa, senza installare nulla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход здесь сразу проверяет ваш Apple ID в Apple, включая двухфакторную аутентификацию, ничего не устанавливая."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此登录会立即向 Apple 验证你的 Apple ID（包括双重认证），不会安装任何内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión aquí comprueba tu ID de Apple con Apple de inmediato, incluida la autenticación de dos factores, sin instalar nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでサインインすると、2要素認証を含めて Apple ID を Apple に直ちに確認します。何もインストールされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar aqui verifica seu ID Apple com a Apple imediatamente, incluindo a verificação em dois fatores, sem instalar nada."
          }
        }
      }
    },
