    "This app uses the set for all apps. Turn on Own set to change it for this app only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App verwendet den Satz für alle Apps. Aktiviere »Eigener Satz«, um ihn nur für diese App zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app usa el conjunto de todas las apps. Activa Conjunto propio para cambiarlo solo en esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app utilise le jeu commun à toutes les apps. Activez « Jeu propre » pour le modifier uniquement pour cette app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app usa il set per tutte le app. Attiva “Set proprio” per cambiarlo solo per questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはすべてのアプリ共通の設定を使用します。「専用の設定」をオンにすると、このアプリだけ変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app usa o conjunto de todos os apps. Ative Conjunto Próprio para mudar isso só para este app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение использует набор для всех приложений. Включите «Собственный набор», чтобы изменить его только для этого приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 使用所有 App 共用的集合。开启“单独集合”即可仅为此 App 更改。"
          }
        }
      }
    },
    "This Apple ID has no free certificate slot, so one has to be revoked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Apple-ID hat keinen freien Zertifikatsplatz, eines muss widerrufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant Apple n'a plus de place pour un certificat, il faut en révoquer un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ID Apple non ha posti liberi per i certificati, quindi uno va revocato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого Apple ID нет свободного места для сертификата, один нужно отозвать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple ID 没有空余的证书名额，需要吊销一个。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ID de Apple no tiene una ranura de certificado gratuita, así que hay que revocar uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple ID には無料の証明書の枠がないため、1つ取り消す必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ID Apple não tem uma vaga de certificado gratuita, então é preciso revogar um."
          }
        }
      }
    },
    "This Apple ID has one team, so AltLoad always uses it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Apple-ID hat nur ein Team, daher verwendet AltLoad es immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ID de Apple tiene un solo equipo, así que AltLoad siempre lo usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant Apple n’a qu’une équipe, donc AltLoad l’utilise toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Apple ID ha un solo team, quindi AltLoad lo usa sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple ID にはチームが1つしかないため、AltLoad は常にそれを使用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ID Apple tem uma só equipe, então o AltLoad sempre a usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого Apple ID одна команда, поэтому AltLoad всегда использует её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple ID 只有一个团队，因此 AltLoad 始终使用它。"
          }
        }
      }
    },
