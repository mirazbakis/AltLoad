    "Long-press a file to change which one is used, or to delete it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine Datei gedrückt, um die verwendete zu ändern oder sie zu löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur un fichier pour changer celui utilisé ou le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un file per cambiare quello in uso o eliminarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте файл, чтобы выбрать используемый или удалить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按文件可更改所用文件或将其删除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un archivo para cambiar cuál se usa o para eliminarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを長押しすると、使用するファイルを変更したり削除したりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um arquivo pressionado para trocar qual é usado ou para excluí-lo."
          }
        }
      }
    },
    "Long-press an app to pick the script it uses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine App gedrückt, um ihr Skript zu wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une app pour choisir son script."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta un'app per scegliere il suo script."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте приложение, чтобы выбрать его скрипт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按 App 以选择它使用的脚本。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una app para elegir el script que usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを長押しすると、使用するスクリプトを選択できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um app pressionado para escolher o script que ele usa."
          }
        }
      }
    },
    "Long-press an app to pin it or pick the script it uses.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine App gedrückt, um sie anzupinnen oder das verwendete Skript auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una app para fijarla o elegir el script que usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une app appuyée pour l’épingler ou choisir le script qu’elle utilise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta un’app per fissarla o scegliere lo script che usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを長押しすると、固定したり、使用するスクリプトを選択したりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um app pressionado para fixá-lo ou escolher o script que ele usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте приложение, чтобы закрепить его или выбрать используемый скрипт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按 App 可将其置顶或选择其使用的脚本。"
          }
        }
      }
    },
    "Long-press an app to stop AltLoad tracking it. Delete it from the Home Screen to uninstall.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine App gedrückt, damit AltLoad sie nicht mehr verfolgt. Lösche sie auf dem Home-Bildschirm, um sie zu deinstallieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une app pour qu'AltLoad cesse de la suivre. Supprimez-la de l'écran d'accueil pour la désinstaller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta un'app perché AltLoad smetta di seguirla. Eliminala dalla schermata Home per disinstallarla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте приложение, чтобы AltLoad перестал его отслеживать. Для удаления удалите его с экрана «Домой»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按 App 可让 AltLoad 停止跟踪。要卸载，请从主屏幕删除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una app para que AltLoad deje de seguirla. Elimínala de la pantalla de inicio para desinstalarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを長押しすると、AltLoadの管理対象から外れます。アンインストールするにはホーム画面から削除してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um app pressionado para que o AltLoad pare de rastreá-lo. Exclua-o da Tela de Início para desinstalar."
          }
        }
      }
    },
