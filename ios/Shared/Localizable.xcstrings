    "AltLoad needs this device's pairing file to install apps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad benötigt die Kopplungsdatei dieses Geräts, um Apps zu installieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad a besoin du fichier de jumelage de cet appareil pour installer des apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad ha bisogno del file di abbinamento di questo dispositivo per installare le app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad нужен файл сопряжения этого устройства, чтобы устанавливать приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad 需要此设备的配对文件才能安装 App。"
          }
        }
      }
    },
    "AltLoad needs this iPhone's pairing file to talk to it, the way a computer would.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad benötigt die Kopplungsdatei dieses iPhones, um wie ein Computer mit ihm zu kommunizieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad a besoin du fichier de jumelage de cet iPhone pour communiquer avec lui, comme le ferait un ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad ha bisogno del file di abbinamento di questo iPhone per comunicare con esso, come farebbe un computer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad нужен файл сопряжения этого iPhone, чтобы связываться с ним, как это делал бы компьютер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad 需要此 iPhone 的配对文件，才能像电脑一样与它通信。"
          }
        }
