    "Signed until %@. AltLoad reminds you the day before.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signiert bis %@. AltLoad erinnert dich am Tag davor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signé jusqu'au %@. AltLoad vous prévient la veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmata fino a %@. AltLoad te lo ricorda il giorno prima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись действует до %@. AltLoad напомнит об этом за день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名有效期至 %@。AltLoad 会提前一天提醒你。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmada hasta %@. AltLoad te lo recuerda el día anterior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ まで署名済みです。AltLoadは前日に通知します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinado até %@. O AltLoad avisa você no dia anterior."
          }
        }
      }
    },
