    "%@ needs JIT to run. Open it with JIT here, or from Tools › JIT, each time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ braucht JIT. Öffne es jedes Mal hier mit JIT oder über Tools › JIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a besoin du JIT. Ouvrez-le avec JIT ici, ou depuis Outils › JIT, à chaque fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ richiede il JIT. Aprilo con JIT da qui, o da Strumenti › JIT, ogni volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ нужен JIT. Каждый раз открывайте его с JIT здесь или в «Инструменты › JIT»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要 JIT 才能运行。每次请在此处或“工具 › JIT”中使用 JIT 打开。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ necesita JIT para ejecutarse. Ábrelo con JIT aquí o desde Herramientas › JIT cada vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の実行にはJITが必要です。毎回ここから、または「ツール」›「JIT」から開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ precisa de JIT para ser executado. Abra-o com JIT aqui ou em Ferramentas › JIT, sempre."
          }
        }
      }
    },
