    "%@ has JIT until you close it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat JIT, bis du es schließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a le JIT jusqu'à ce que vous la fermiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha il JIT finché non la chiudi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ есть JIT, пока вы его не закроете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在你关闭它之前都有 JIT。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene JIT hasta que lo cierres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は閉じるまでJITが有効です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem JIT até você fechá-lo."
          }
        }
      }
    },
    "%@ has JIT. AltLoad let go when it was done.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat JIT. AltLoad hat sich gelöst, als es fertig war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a le JIT. AltLoad l'a laissée quand elle a eu fini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha il JIT. AltLoad l'ha lasciata quando ha finito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ есть JIT. AltLoad отключился, когда приложение закончило."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已获得 JIT。完成后 AltLoad 已断开。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene JIT. AltLoad lo soltó al terminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はJITが有効です。完了したためAltLoadは解放しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem JIT. O AltLoad o liberou quando terminou."
          }
        }
      }
    },
    "%@ has JIT. AltLoad prepared its JIT memory %lld times, then let go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat JIT. AltLoad hat seinen JIT-Speicher %lld-mal vorbereitet und sich dann gelöst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a le JIT. AltLoad a préparé sa mémoire JIT %lld fois, puis l'a laissée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha il JIT. AltLoad ha preparato la sua memoria JIT %lld volte, poi l'ha lasciata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ есть JIT. AltLoad подготовил его память JIT %lld раз и отключился."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已获得 JIT。AltLoad 为它准备了 %lld 次 JIT 内存，然后断开。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene JIT. AltLoad preparó su memoria JIT %lld veces y luego lo soltó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はJITが有効です。AltLoadはJITメモリを%lld回準備し、その後解放しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem JIT. O AltLoad preparou a memória JIT dele %lld vezes e depois a liberou."
          }
        }
      }
    },
    "%@ is open with JIT. It keeps JIT until you close it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist mit JIT geöffnet. JIT bleibt aktiv, bis du die App schließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est ouvert avec le JIT. Il le conserve jusqu'à sa fermeture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è aperta con JIT. Lo mantiene finché non la chiudi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открыто с JIT. JIT работает, пока вы не закроете приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已以 JIT 模式打开，在你关闭它之前 JIT 会一直有效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está abierto con JIT. Mantiene JIT hasta que lo cierres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はJITで開いています。閉じるまでJITを維持します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está aberto com JIT. Ele mantém o JIT até você fechá-lo."
          }
        }
      }
    },
