          "stringUnit": {
            "state": "translated",
            "value": "需要“本地网络”权限。请在“设置 › AltLoad › 本地网络”中开启，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de red local. Actívalo en Ajustes › AltLoad › Red local y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークの許可が必要です。「設定」›「AltLoad」›「ローカルネットワーク」でオンにしてから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária a permissão de Rede Local. Ative-a em Ajustes › AltLoad › Rede Local e tente novamente."
          }
        }
      }
    },
    "LocalDevVPN": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN"
          }
        },
        "es": {
