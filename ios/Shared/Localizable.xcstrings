    "This iPhone's pairing file is already inside the app. If the app still asks for it, restart your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplungsdatei dieses iPhones ist bereits in der App. Falls die App weiter danach fragt, starte dein iPhone neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de jumelage de cet iPhone est déjà dans l'app. Si elle le demande encore, redémarrez votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di abbinamento di questo iPhone è già nell'app. Se lo chiede ancora, riavvia l'iPhone."
          }
        },
        "ru": {
