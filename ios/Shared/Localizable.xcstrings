    "AltLoad can refresh it by itself once the password for its Apple ID is saved. Open AltLoad and refresh it once with Remember password on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad kann es selbst aktualisieren, sobald das Passwort seiner Apple-ID gespeichert ist. Öffne AltLoad und aktualisiere es einmal mit „Passwort merken“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad peut l'actualiser seul dès que le mot de passe de son identifiant Apple est enregistré. Ouvrez AltLoad et actualisez-la une fois avec « Mémoriser le mot de passe » activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad può aggiornarla da solo quando la password del suo ID Apple è salvata. Apri AltLoad e aggiornala una volta con «Ricorda password» attivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad сможет обновлять его сам, когда пароль его Apple ID будет сохранён. Откройте AltLoad и обновите его один раз с включённым «Запомнить пароль»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存其 Apple ID 的密码后，AltLoad 就能自行刷新。打开 AltLoad，在开启“记住密码”的情况下刷新一次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad puede actualizarla por sí misma una vez guardada la contraseña de su ID de Apple. Abre AltLoad y actualízala una vez con Recordar contraseña activado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID のパスワードが保存されていれば、AltLoadは自動で更新できます。AltLoadを開き、「パスワードを記憶」をオンにした状態で一度更新してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AltLoad pode atualizá-lo sozinho quando a senha do ID Apple dele estiver salva. Abra o AltLoad e atualize-o uma vez com Lembrar senha ativado."
          }
        }
      }
    },
    "AltLoad can't enable JIT. Use StikDebug for that.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
