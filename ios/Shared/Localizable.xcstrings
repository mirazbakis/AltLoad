            "state": "translated",
            "value": "AltLoad-Kopplungscode"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code de jumelage AltLoad"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice di abbinamento AltLoad"
          }
        },
        "ru": {
