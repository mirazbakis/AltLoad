          "stringUnit": {
            "state": "translated",
            "value": "Für die zuverlässigste Kopplung erlaube den Standort **Immer**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un jumelage plus fiable, autorisez la position **Toujours**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un abbinamento più affidabile, consenti la posizione **Sempre**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для наиболее надёжного сопряжения разрешите геопозицию **Всегда**."
