    "Extensions share the app's profile, so only one App ID is used. Some may not run.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterungen teilen das Profil der App, daher wird nur eine App-ID genutzt. Manche laufen eventuell nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extensions partagent le profil de l'app : un seul identifiant d'app est utilisé. Certaines peuvent ne pas fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le estensioni condividono il profilo dell'app, quindi si usa un solo ID app. Alcune potrebbero non funzionare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширения используют профиль приложения, поэтому нужен только один App ID. Некоторые могут не работать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展共用 App 的描述文件，因此只使用一个 App ID。部分扩展可能无法运行。"
          }
        }
      }
    },
