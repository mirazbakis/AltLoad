      }
    },
    "Long-press an app to stop AltLoad tracking it. Delete it from the Home Screen to uninstall.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine App gedrückt, damit AltLoad sie nicht mehr verfolgt. Lösche sie auf dem Home-Bildschirm, um sie zu deinstallieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une app pour qu'AltLoad cesse de la suivre. Supprimez-la de l'écran d'accueil pour la désinstaller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta un'app perché AltLoad smetta di seguirla. Eliminala dalla schermata Home per disinstallarla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте приложение, чтобы AltLoad перестал его отслеживать. Для удаления удалите его с экрана «Домой»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按 App 可让 AltLoad 停止跟踪。要卸载，请从主屏幕删除。"
          }
        }
      }
    },
