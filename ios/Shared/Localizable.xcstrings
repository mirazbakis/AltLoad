    "There's no pairing file for this iPhone yet. Create one in Tools › Pair first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses iPhone gibt es noch keine Kopplungsdatei. Erstelle zuerst eine unter Werkzeuge › Koppeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n'a pas encore de fichier de jumelage. Créez-en d'abord un dans Outils › Jumeler."
          }
        },
        "it": {
          "stringUnit": {
