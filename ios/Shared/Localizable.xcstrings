          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien demande le script « %@ », qui n'est pas dans AltLoad. Importez-le dans Outils › JIT › Scripts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link chiede lo script \"%@\", che non è in AltLoad. Importalo in Strumenti › JIT › Script."
          }
        },
        "ru": {
