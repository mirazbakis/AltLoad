    "AltLoad isn't affiliated with AltStore, SideStore, LiveContainer, Husk, Riley Testut or Apple. Apple, iPhone and iOS are trademarks of Apple Inc.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AltLoad ist nicht mit AltStore, SideStore, LiveContainer, Husk, Riley Testut oder Apple verbunden. Apple, iPhone und iOS sind Marken von Apple Inc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
