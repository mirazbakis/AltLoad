    "%@ %@ is on your Home Screen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ist auf deinem Home-Bildschirm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ est sur votre écran d'accueil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ è nella schermata Home"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ на экране «Домой»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 已在主屏幕上"
          }
        }
      }
    },
    "%@ closed. Open it with JIT again next time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde geschlossen. Öffne es nächstes Mal wieder mit JIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'est fermée. Rouvrez-la avec JIT la prochaine fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si è chiusa. La prossima volta riaprila con JIT."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ закрыт. В следующий раз снова откройте его с JIT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已关闭。下次请再用 JIT 打开。"
          }
        }
      }
    },
    "%@ didn't return anisette data AltStore can use. Pick another anisette server in AltLoad's Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keine Anisette-Daten geliefert, die AltStore verwenden kann. Wähle in den Einstellungen von AltLoad einen anderen Anisette-Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas renvoyé de données anisette utilisables par AltStore. Choisissez un autre serveur anisette dans les réglages d'AltLoad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha restituito dati anisette utilizzabili da AltStore. Scegli un altro server anisette nelle impostazioni di AltLoad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не вернул данные anisette, которые может использовать AltStore. Выберите другой сервер anisette в настройках AltLoad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未返回 AltStore 可用的 anisette 数据。请在 AltLoad 设置中选择其他 anisette 服务器。"
          }
        }
      }
    },
    "%@ expires tomorrow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft morgen ab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expire demain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ scade domani"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ истекает завтра"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 明天到期"
          }
        }
      }
    },
    "%@ has JIT until you close it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat JIT, bis du es schließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a le JIT jusqu'à ce que vous la fermiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha il JIT finché non la chiudi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ есть JIT, пока вы его не закроете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在你关闭它之前都有 JIT。"
          }
        }
      }
    },
    "%@ has JIT. AltLoad let go when it was done.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat JIT. AltLoad hat sich gelöst, als es fertig war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a le JIT. AltLoad l'a laissée quand elle a eu fini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha il JIT. AltLoad l'ha lasciata quando ha finito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ есть JIT. AltLoad отключился, когда приложение закончило."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已获得 JIT。完成后 AltLoad 已断开。"
          }
        }
      }
    },
    "%@ has JIT. AltLoad prepared its JIT memory %lld times, then let go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat JIT. AltLoad hat seinen JIT-Speicher %lld-mal vorbereitet und sich dann gelöst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a le JIT. AltLoad a préparé sa mémoire JIT %lld fois, puis l'a laissée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha il JIT. AltLoad ha preparato la sua memoria JIT %lld volte, poi l'ha lasciata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ есть JIT. AltLoad подготовил его память JIT %lld раз и отключился."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已获得 JIT。AltLoad 为它准备了 %lld 次 JIT 内存，然后断开。"
          }
        }
      }
    },
    "%@ is open with JIT. It keeps JIT until you close it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist mit JIT geöffnet. JIT bleibt aktiv, bis du die App schließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est ouvert avec le JIT. Il le conserve jusqu'à sa fermeture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è aperta con JIT. Lo mantiene finché non la chiudi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открыто с JIT. JIT работает, пока вы не закроете приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已以 JIT 模式打开，在你关闭它之前 JIT 会一直有效。"
          }
        }
      }
    },
    "%@ isn't listed in the configured source.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in der konfigurierten Quelle nicht aufgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne figure pas dans la source configurée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è presente nella sorgente configurata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ нет в указанном источнике."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置的源中未列出 %@。"
          }
        }
      }
    },
    "%@ needs JIT to run. Open it with JIT here, or from Tools › JIT, each time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ braucht JIT. Öffne es jedes Mal hier mit JIT oder über Tools › JIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a besoin du JIT. Ouvrez-le avec JIT ici, ou depuis Outils › JIT, à chaque fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ richiede il JIT. Aprilo con JIT da qui, o da Strumenti › JIT, ogni volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ нужен JIT. Каждый раз открывайте его с JIT здесь или в «Инструменты › JIT»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要 JIT 才能运行。每次请在此处或“工具 › JIT”中使用 JIT 打开。"
          }
        }
      }
    },
    "%@ now has the pairing file. Reopen the app so it picks the file up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat jetzt die Kopplungsdatei. Öffne die App erneut, damit sie die Datei übernimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contient maintenant le fichier de jumelage. Rouvrez l'app pour qu'elle le prenne en compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora ha il file di abbinamento. Riapri l'app per fargli leggere il file."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь в %@ есть файл сопряжения. Откройте приложение заново, чтобы оно его прочитало."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在已有配对文件。请重新打开该 App 以读取文件。"
          }
        }
      }
    },
    "%@'s repository is down": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository von %@ ist nicht erreichbar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt de %@ est indisponible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository di %@ non è disponibile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий %@ недоступен"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的仓库无法访问"
          }
        }
      }
    },
    "%@'s repository is down right now and AltLoad has no copy saved. Try again later, or download the IPA elsewhere and pick it with Install IPA from Files.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository von %@ ist gerade nicht erreichbar und AltLoad hat keine Kopie gespeichert. Versuche es später erneut oder lade die IPA anderswo herunter und wähle sie über „IPA aus Dateien installieren“ aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt de %@ est indisponible pour le moment et AltLoad n'en a aucune copie. Réessayez plus tard, ou téléchargez l'IPA ailleurs et choisissez-le avec Installer un IPA depuis Fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository di %@ non è disponibile al momento e AltLoad non ne ha una copia salvata. Riprova più tardi, oppure scarica l'IPA altrove e sceglilo con Installa IPA da File."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий %@ сейчас недоступен, а сохранённой копии в AltLoad нет. Повторите позже или скачайте IPA в другом месте и выберите его через «Установить IPA из Файлов»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的仓库目前无法访问，AltLoad 也没有保存副本。请稍后再试，或在其他地方下载 IPA，然后通过“从文件安装 IPA”选择。"
          }
        }
      }
    },
