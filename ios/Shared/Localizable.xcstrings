    },
    "A preset switches its entitlements on. It doesn't turn others off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Voreinstellung schaltet ihre Berechtigungen ein. Andere werden nicht ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preajuste activa sus derechos. No desactiva los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un préréglage active ses droits. Il ne désactive pas les autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preset attiva i suoi diritti. Non disattiva gli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットは、そのエンタイトルメントをオンにします。他はオフにしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma predefinição ativa os direitos dela. Ela não desativa os outros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресет включает свои права, но не отключает остальные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设只会开启它自己的权利，不会关闭其他权利。"
          }
        }
      }
    },
