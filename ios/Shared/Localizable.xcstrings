    "A larger address space, used by emulators and JIT apps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein größerer Adressraum, genutzt von Emulatoren und JIT-Apps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace d'adressage plus grand, utilisé par les émulateurs et les apps JIT"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno spazio di indirizzi più ampio, usato da emulatori e app JIT"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большее адресное пространство для эмуляторов и JIT-приложений"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更大的地址空间，供模拟器和 JIT App 使用"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio de direcciones más grande, usado por emuladores y apps con JIT"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エミュレータやJITアプリで使われる、より大きなアドレス空間"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um espaço de endereços maior, usado por emuladores e apps com JIT"
          }
        }
      }
    },
    "A link asks AltLoad to open %@ with JIT and run a script it carries in AltLoad's debugger. Only allow this from apps you trust.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link bittet AltLoad, %@ mit JIT zu öffnen und ein mitgeliefertes Skript im Debugger von AltLoad auszuführen. Erlaube das nur bei Apps, denen du vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien demande à AltLoad d'ouvrir %@ avec JIT et d'exécuter dans son débogueur un script qu'il contient. N'autorisez cela que pour des apps de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link chiede ad AltLoad di aprire %@ con JIT ed eseguire nel suo debugger uno script che contiene. Consentilo solo per app di cui ti fidi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка просит AltLoad открыть %@ с JIT и запустить в отладчике AltLoad скрипт, который она содержит. Разрешайте это только для приложений, которым доверяете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个链接请求 AltLoad 用 JIT 打开 %@，并在 AltLoad 的调试器中运行它附带的脚本。只对你信任的 App 允许此操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace pide a AltLoad que abra %@ con JIT y ejecute un script que incluye en su depurador. Permítelo solo con apps de confianza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクがAltLoadに対し、%@ をJITで開き、AltLoadのデバッガで同梱のスクリプトを実行するよう求めています。信頼するアプリからの場合のみ許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link pede ao AltLoad para abrir %@ com JIT e executar um script que ele traz no depurador. Permita isso apenas para apps em que você confia."
          }
        }
      }
    },
    "A link asks AltLoad to open %@ with JIT.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
