    "Pairing on this device needs iOS 27. On iOS %@, make a pairing file on a computer once, then bring it here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplung auf diesem Gerät erfordert iOS 27. Erstelle unter iOS %@ einmal eine Kopplungsdatei auf einem Computer und übertrage sie hierher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jumelage sur cet appareil nécessite iOS 27. Sous iOS %@, créez une fois un fichier de jumelage sur un ordinateur, puis apportez-le ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbinamento su questo dispositivo richiede iOS 27. Su iOS %@, crea una volta un file di abbinamento su un computer e trasferiscilo qui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сопряжения на этом устройстве нужна iOS 27. На iOS %@ один раз создайте файл сопряжения на компьютере и перенесите его сюда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上配对需要 iOS 27。在 iOS %@ 上，请先在电脑上创建一次配对文件，再传到这里。"
          }
        }
      }
    },
