    "Your team is a free personal team, so AltLoad leaves these out when it signs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Team ist ein kostenloses persönliches Team, daher lässt AltLoad diese beim Signieren weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu equipo es un equipo personal gratuito, así que AltLoad no incluye estos al firmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe est une équipe personnelle gratuite, donc AltLoad les omet lors de la signature."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo team è un team personale gratuito, quindi AltLoad le esclude quando firma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのチームは無料の個人チームのため、AltLoad は署名時にこれらを除外します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua equipe é uma equipe pessoal gratuita, então o AltLoad deixa estes de fora ao assinar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
