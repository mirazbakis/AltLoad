# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
._*

# ---- Xcode (the project is generated from project.yml by XcodeGen) ----
AltLoad.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.dSYM
*.dSYM.zip
*.hmap
*.moved-aside

# ---- Swift Package Manager ----
.build/
.swiftpm/

# ---- Rust ----
target/
**/*.rs.bk

# ---- Build outputs ----
AltLoadFFI.xcframework/
*.ipa
Payload/

# ---- Signing material & secrets: never commit these ----
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.pem
*.key
.env
.env.*
CodeSigning.xcconfig

# ---- Device pairing files grant access to a device ----
rp_pairing_file*.plist
*.mobiledevicepairing
*.plist.pairing

# ---- Editors ----
.idea/
.vscode/
*.swp
*~

# ---- Claude Code: personal settings stay local ----
.claude/settings.local.json

# ---- OTA ad-hoc signing packs: intentionally committed ----
# These ad-hoc .p12/.mobileprovision are deliberately tracked (owner's choice,
# public repo). They only produce installs for UDIDs already in each profile.
# This re-includes ONLY the packs under ota/certs/ — signing material anywhere
# else in the repo stays ignored by the rules above.
!ota/certs/
!ota/certs/*/
!ota/certs/**/*.p12
!ota/certs/**/*.mobileprovision
